# The Omarchy side of Multiplex, built from the checkout this file is in:
#   cd dist/arch && makepkg -si
pkgname=multiplex-omarchy
pkgver=0.1.0
pkgrel=1
pkgdesc="The Omarchy side of Multiplex: pair a phone by QR code and control the computer from it"
arch=('x86_64' 'aarch64')
url="https://github.com/molotovgit/multiplex"
license=('custom')
depends=('openssh' 'gliff' 'iproute2' 'libxkbcommon')
makedepends=('cargo')
optdepends=(
  'tailscale: reach the computer from anywhere'
  'ufw: firewall rules written by multiplex setup'
  'fcitx5: the phone keyboard opens when a text field has the focus'
  'libnotify: notices when a phone pairs and when files arrive or are delivered'
  'wl-clipboard: the clipboard shared with the phone, and typing outside the US keyboard from its touchpad'
  'xdg-user-dirs: files from the phone go to the Downloads folder it names'
  'networkmanager: multiplex setup turns Wake-on-LAN on'
  "mpv: the phone's screen in a window"
  "ffmpeg: the phone's camera as a webcam"
  "gst-plugin-pipewire: the phone's camera as a PipeWire camera (with gstreamer and gst-plugins-base)"
  "v4l2loopback-dkms: the phone's camera for every program that uses a webcam"
)
options=('!debug')

_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

build() {
  cd "$_repo/desktop"
  cargo build --release --locked
}

check() {
  cd "$_repo/desktop"
  cargo test --release --locked
}

package() {
  install -Dm755 "$_repo/desktop/target/release/multiplex" "$pkgdir/usr/bin/multiplex"
  # Not enabled by itself: `systemctl --user enable --now multiplex-agent`.
  install -Dm644 "$_repo/dist/arch/multiplex-agent.service" "$pkgdir/usr/lib/systemd/user/multiplex-agent.service"
}
