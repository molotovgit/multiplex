<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SSH, SFTP and tunnels need the network. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- To reconnect as soon as the network comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Remote desktop: keeps Wi-Fi out of power saving (low-latency lock) while it is open. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Fingerprint, face or PIN for the optional app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Keep connections alive in the background (see SessionService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- A paired computer can send a text message through the phone
         (`multiplex sms`), once the user switches that on for it. -->
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>
    <!-- Two-pane copy and folder sync with the phone's shared storage. Only
         used after the user taps "Allow access" (see StorageChannel). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <!-- The in-app updater opens the system installer for a new version
         downloaded from GitHub Releases (see UpdateChannel). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Pairing: have Play services fetch its QR scanner screen at install time, not on first use. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui"/>
        <!-- No cloud backup or device transfer of app data: the vault's key
             lives in the Android Keystore and cannot travel with it, so a
             copied vault could never be opened. Use the in-app encrypted
             backup instead. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Paired computers as direct targets in the share sheet. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/share_targets" />
            <!-- "Share" from other apps: upload the files to a server. -->
            <intent-filter android:label="Upload to a server">
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's open SSH terminal sessions and port forwards connected while the app is in the background." />
        </service>
        <!-- Phone notifications for a paired computer. Android runs this only
             after the user allows it under Settings > Notification access. -->
        <service
            android:name=".PhoneNotifications"
            android:exported="true"
            android:label="Multiplex: notifications for your computer"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Stops the ringing started by "find this phone". -->
        <receiver android:name=".PhoneChannel$StopRing" android:exported="false" />
        <!-- The home-screen widget with favourite hosts. -->
        <receiver
            android:name=".FavouritesWidget"
            android:exported="false"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favourites_widget_info" />
        </receiver>
        <!-- Hands a downloaded update (cache/updates only) to the system
             installer. -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ hides other apps unless asked: lets a tapped link
             in the terminal find a browser (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
