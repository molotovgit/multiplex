<?xml version="1.0" encoding="utf-8"?>
<!-- VaultTerm's icon: a shell prompt (chevron and cursor) inside a ring,
     like the dial of a vault. Drawn as a vector so it is sharp on every
     screen. The visible part stays inside the 66 dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2B33D"
        android:strokeAlpha="0.35"
        android:strokeWidth="3"
        android:pathData="M54,25 a29,29 0 1,1 0,58 a29,29 0 1,1 0,-58" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2B33D"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M41,43 L52,54 L41,65" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2B33D"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M57,65 L68,65" />
</vector>
